enum DueStatus {
  UNPAID
  PAID
  OVERDUE
}

model MonthlyDue {
  id        String        @id @default(uuid())
  memberId  String
  member    MemberProfile @relation(fields: [memberId], references: [id])
  month     Int
  year      Int
  amount    Decimal       @db.Decimal(10, 2)
  status    DueStatus     @default(UNPAID)
  dueDate   DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  payment Payment?

  @@unique([memberId, month, year])
  @@map("monthly_dues")
}
